{
    "version": "0.1.0",
    "description": "Create and manage supply-chain-safe dev sandboxes",
    "homepage": "https://github.com/eetu/luoto",
    "license": "MIT",
    "notes": "luoto needs a container runtime: podman or Docker. Then run: luoto setup",
    "architecture": {
        "64bit": {
            "url": "https://github.com/eetu/luoto/releases/download/v0.1.0/luoto-0.1.0-x86_64-pc-windows-msvc.zip",
            "hash": "f89bf07844278600db474dbd7475bcc6893459a4624dae4500e97dfe27529d96",
            "extract_dir": "luoto-0.1.0-x86_64-pc-windows-msvc"
        }
    },
    "bin": "luoto.exe",
    "checkver": {
        "github": "https://github.com/eetu/luoto"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/eetu/luoto/releases/download/v$version/luoto-$version-x86_64-pc-windows-msvc.zip",
                "hash": {
                    "url": "$baseurl/SHA256SUMS",
                    "regex": "$sha256\\s+$basename"
                },
                "extract_dir": "luoto-$version-x86_64-pc-windows-msvc"
            }
        }
    }
}
